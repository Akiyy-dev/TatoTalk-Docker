# Copy to .env and set exactly 8 English letters or digits before starting.
# Only A-Z, a-z and 0-9 are accepted; traditional VNC uses 8 characters.
VNC_PASSWORD=
NOVNC_PORT=6090

# Host: x86_64 with usable KVM. Guest RAM/cores and container limits are separate.
EMULATOR_ADDITIONAL_ARGS=-memory 2048 -cores 2 -no-snapshot -no-boot-anim -no-audio
ANDROID_MEMORY_LIMIT=6g
ANDROID_CPU_LIMIT=2.0
TATOTALK_BOOT_TIMEOUT=300
TATOTALK_EXPECTED_ABI=arm64-v8a

# Official APK observed on 2026-10-12. Download happens only with probe.py install.
# SHA256 is optional; set it if you independently obtained a trusted checksum.
TATOTALK_APK_URL=https://downtato.ffvjei.com/android/TatoTalk-26100306.apk
TATOTALK_APK_SHA256=

# Pinned upstream image. An approved mirror may be substituted if needed.
ANDROID_BASE_IMAGE=budtmo/docker-android:emulator_11.0@sha256:ee03fa21a88ea86fe5be803936391d82ee1a853cb19ac6a6e0800ebfcaaf6dc2
